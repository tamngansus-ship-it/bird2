<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 320" width="100%" height="100%">
  <defs>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E0F2FE"/>
      <stop offset="100%" stop-color="#BAE6FD"/>
    </linearGradient>
  </defs>

  <rect width="100%" height="100%" rx="16" fill="url(#cardGrad)" stroke="#0284C7" stroke-width="2"/>
  
  <!-- Thai Garuda Emblem Mock -->
  <circle cx="50" cy="50" r="22" fill="#DC2626"/>
  <path d="M 40,50 Q 50,32 60,50 Q 50,60 40,50 Z" fill="#FDE047"/>

  <!-- Card Title -->
  <text x="85" y="45" font-family="'Prompt', sans-serif" font-size="16" font-weight="bold" fill="#0F172A">
    บัตรประจำตัวประชาชนไทย THAI NATIONAL ID CARD
  </text>
  <text x="85" y="65" font-family="'Prompt', sans-serif" font-size="13" font-weight="bold" fill="#0369A1">
    เลขประจำตัวประชาชน 1 1037 02584 12 9
  </text>

  <!-- Photo Box -->
  <rect x="340" y="80" width="130" height="170" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
  <circle cx="405" cy="140" r="30" fill="#94A3B8"/>
  <path d="M 355,230 C 355,185 455,185 455,230 Z" fill="#1E3A8A"/>

  <!-- Details -->
  <text x="35" y="115" font-family="'Prompt', sans-serif" font-size="12" fill="#334155">ชื่อตัวและชื่อสกุล: นายกิตติศักดิ์ ทองมี</text>
  <text x="35" y="138" font-family="'Prompt', sans-serif" font-size="11" fill="#64748B">Name: Mr. Kittisak Thongmee</text>
  <text x="35" y="170" font-family="'Prompt', sans-serif" font-size="12" fill="#334155">เกิดวันที่: 14 พ.ค. 2552</text>
  <text x="35" y="195" font-family="'Prompt', sans-serif" font-size="12" fill="#334155">ที่อยู่: 45/2 หมู่ 3 ต.บ้านครัว อ.บ้านหมอ จ.สระบุรี</text>

  <!-- Hologram / Chip -->
  <rect x="35" y="225" width="45" height="35" rx="4" fill="#F59E0B" stroke="#B45309"/>

  <text x="250" y="295" font-family="'Prompt', sans-serif" font-size="12" font-weight="bold" fill="#059669" text-anchor="middle">
    [ สำเนาถูกต้อง - ใช้สำหรับการสมัครเรียน วท.ท่าหลวงฯ เท่านั้น ]
  </text>
</svg>
